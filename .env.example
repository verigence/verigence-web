# Environment-specific service endpoints only.
# Tenant, dealer and outlet scope are established at runtime after login.
VITE_AUDIT_CORE_BASE_URL=http://localhost:8002

# UC-001 calls Verigence Security through the approved Security API boundary.
# Browser builds normally leave this blank because the Cloudflare Web Worker provides
# the same-origin /security/* proxy. The DEV proxy upstream is configured in the
# Cloudflare deployment workflow as https://security-dev.up.railway.app.
VITE_SECURITY_BASE_URL=
