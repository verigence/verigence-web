{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verigence-web-dev",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    "SECURITY_UPSTREAM": "https://security-dev.up.railway.app",
    "AUDIT_CORE_UPSTREAM": "https://verigence-audit-core-production.up.railway.app"
  },
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/security/*", "/audit-core/*"]
  }
}
