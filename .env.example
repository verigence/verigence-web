# Web runs as a fully navigable demo until Security/Audit Core authentication is connected.
VITE_WEB_MODE=demo

# Switch to `core` to use live Audit Core APIs.
VITE_AUDIT_CORE_BASE_URL=http://localhost:8002
VITE_TENANT_ID=TENANT-DEMO
VITE_DEFAULT_DEALER_ID=11111111-1111-4111-8111-111111111111
VITE_DEFAULT_OUTLET_ID=22222222-2222-4222-8222-222222222222
