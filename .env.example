# Environment-specific service endpoints only.
# Tenant, dealer and outlet scope are established at runtime after login.
VITE_AUDIT_CORE_BASE_URL=http://localhost:8002

# UC-001 calls Verigence Security directly through the approved Security API boundary.
# Set this to the environment-specific Security base URL. Leave blank only when the Web host
# provides a same-origin route/proxy for /security/*.
VITE_SECURITY_BASE_URL=
