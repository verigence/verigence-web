# Capacitor DEV build endpoints.
# The native WebView does not share the Cloudflare browser origin, so Security calls
# use the deployed Web Worker gateway explicitly.
VITE_SECURITY_BASE_URL=https://verigence-web-dev.jbrconsulting-it.workers.dev

# Keep aligned with the Web DEV environment when Audit Core DEV is configured.
VITE_AUDIT_CORE_BASE_URL=
