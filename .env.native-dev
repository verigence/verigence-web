# Capacitor DEV build endpoints.
# The native WebView does not share the Cloudflare browser origin, so Security calls
# use the deployed Web Worker gateway explicitly.
VITE_SECURITY_BASE_URL=https://verigence.jbrconsulting.in

# Route Audit Core through the same Cloudflare DEV worker used by Web DEV.
# This avoids direct native-WebView calls to Railway, including CORS/origin mismatch.
VITE_AUDIT_CORE_BASE_URL=
VITE_AUDIT_CORE_PROXY_BASE_URL=https://verigence.jbrconsulting.in/audit-core
VITE_HR_PROXY_BASE_URL=https://verigence.jbrconsulting.in/hr-api
