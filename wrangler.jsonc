{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verigence-web-dev",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-20",
  // The one public address, on the JBR Consulting domain (Cloudflare creates the DNS record and
  // certificate). The workers.dev address stays on only for the API calls of Android apps released
  // before 1.6.5; the Worker sends browsers there to the public address (LEGACY_APP_HOST below).
  // Declaring a route turns workers.dev off unless it is set here.
  "workers_dev": true,
  "routes": [{ "pattern": "verigence.jbrconsulting.in", "custom_domain": true }],
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    "SECURITY_UPSTREAM": "https://security-dev.up.railway.app",
    "AUDIT_CORE_UPSTREAM": "https://verigence-audit-core-production.up.railway.app",
    "ANALYTICS_UPSTREAM": "https://analytics-dev.up.railway.app",
    "DI_UPSTREAM": "https://di-api-dev.up.railway.app",
    "HR_UPSTREAM": "https://attendance-dev.up.railway.app",
    "LOG_PROXY_SUCCESS": "false",
    "PUBLIC_ORIGIN": "https://verigence.jbrconsulting.in",
    "LEGACY_APP_HOST": "verigence-web-dev.jbrconsulting-it.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "APP_RELEASES",
      "bucket_name": "verigence-app-releases"
    }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker first so the old address can send browsers on;
    // anything that is not an API route is then served from the assets.
    "run_worker_first": true
  }
}
