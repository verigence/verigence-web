{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verigence-web-dev",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-20",
  // Public address on the JBR Consulting domain (Cloudflare creates the DNS record and certificate).
  // The workers.dev address stays on permanently: Android apps released before 1.6.5 call it, and
  // they must keep working. Declaring a route turns workers.dev off unless it is set here.
  "workers_dev": true,
  "routes": [{ "pattern": "verigence.jbrconsulting.in", "custom_domain": true }],
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    "SECURITY_UPSTREAM": "https://security-dev.up.railway.app",
    "AUDIT_CORE_UPSTREAM": "https://verigence-audit-core-production.up.railway.app",
    "ANALYTICS_UPSTREAM": "https://analytics-dev.up.railway.app",
    "DI_UPSTREAM": "https://di-api-dev.up.railway.app",
    "HR_UPSTREAM": "https://attendance-dev.up.railway.app",
    "LOG_PROXY_SUCCESS": "false"
  },
  "r2_buckets": [
    {
      "binding": "APP_RELEASES",
      "bucket_name": "verigence-app-releases"
    }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/security/*", "/audit-core/*", "/analytics-api/*", "/di/*", "/hr-api/*", "/app-distribution/*"]
  }
}
